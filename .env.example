# Interface HTTP. Use o IP privado da WEB01 para acesso direto pela rede.
# Com proxy reverso local, use 127.0.0.1.
HOST=127.0.0.1
PORT=3000

# MySQL local. Para duas VMs, use o IP privado da DB01.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=musicbox
DB_USER=musicbox_app
DB_PASSWORD=

# Usados apenas quando ainda não há administrador no banco.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
